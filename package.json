{
  "name": "cosmodromo",
  "version": "3.2.0",
  "description": "Cosmódromo: sandbox planetario 3D para PC y móvil, iniciador automático Node.js, minería, construcción e inventario",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable",
    "server": "node server.js"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cosmodromo.game",
    "productName": "Cosmodromo",
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "wasm/**",
      "lib/**",
      "main.js",
      "server.js",
      "package.json"
    ],
    "win": {
      "target": "portable"
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}
